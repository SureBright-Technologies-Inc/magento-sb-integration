<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">surebright_webhook_errors_listing.surebright_webhook_errors_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>surebright_webhook_errors_columns</spinner>
        <deps>
            <dep>surebright_webhook_errors_listing.surebright_webhook_errors_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="surebright_webhook_errors_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">error_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Surebright_Integration::webhook_errors</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="surebright_webhook_errors_listing_data_source">
            <settings>
                <requestFieldName>error_id</requestFieldName>
                <primaryFieldName>error_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="surebright_webhook_errors_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">surebright_webhook_errors_listing.surebright_webhook_errors_listing.surebright_webhook_errors_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">view</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <column name="error_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <column name="event_type" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Event Type</label>
            </settings>
        </column>
        <column name="error_type" sortOrder="40">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Surebright\Integration\Model\WebhookError\Source\ErrorType"/>
                <label translate="true">Error Type</label>
            </settings>
        </column>
        <column name="http_status" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">HTTP Status</label>
            </settings>
        </column>
        <column name="entity_id" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Entity ID</label>
            </settings>
        </column>
        <column name="entity_sku" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU</label>
            </settings>
        </column>
        <column name="store_id" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Store ID</label>
            </settings>
        </column>
        <column name="error_message" sortOrder="90">
            <settings>
                <filter>text</filter>
                <label translate="true">Error Message</label>
            </settings>
        </column>
        <column name="request_url" sortOrder="100" component="Magento_Ui/js/grid/columns/column">
            <settings>
                <visible>false</visible>
                <label translate="true">Request URL</label>
            </settings>
        </column>
        <column name="request_payload" sortOrder="110" component="Magento_Ui/js/grid/columns/column">
            <settings>
                <visible>false</visible>
                <label translate="true">Request Payload</label>
            </settings>
        </column>
        <column name="response_body" sortOrder="120" component="Magento_Ui/js/grid/columns/column">
            <settings>
                <visible>false</visible>
                <label translate="true">Response Body</label>
            </settings>
        </column>
    </columns>
</listing>
