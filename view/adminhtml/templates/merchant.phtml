<script>
    require(['jquery'], function ($) {
        'use strict';

        var testUrl = <?= /* @noEscape */ json_encode($block->getTestUrl()) ?>;
        var webhookTestUrl = <?= /* @noEscape */ json_encode($block->getWebhookTestUrl()) ?>;
        var reindexUrl = <?= /* @noEscape */ json_encode($block->getReindexUrl()) ?>;
        var cachePurgeUrl = <?= /* @noEscape */ json_encode($block->getCachePurgeUrl()) ?>;
        var formKey = <?= /* @noEscape */ json_encode($block->getPageFormKey()) ?>;

        function renderResult($el, ok, message) {
            $el.removeClass('sb-result-ok sb-result-fail')
                .addClass(ok ? 'sb-result-ok' : 'sb-result-fail')
                .text(message)
                .show();
        }

        function renderSteps($el, response) {
            var html = $('<div/>').text(response.message || 'Done.');
            if (response.steps && response.steps.length) {
                var $ul = $('<ul class="sb-step-list"/>');
                response.steps.forEach(function (step) {
                    $('<li/>')
                        .addClass(step.ok ? 'sb-step-ok' : 'sb-step-fail')
                        .text(step.step + ': ' + step.detail)
                        .appendTo($ul);
                });
                html.append($ul);
            }
            $el.removeClass('sb-result-ok sb-result-fail')
                .addClass(response.success ? 'sb-result-ok' : 'sb-result-fail')
                .html(html.html())
                .show();
        }

        $('.sb-diagnostics-toggle').on('click', function () {
            var $wrap = $(this).closest('.sb-diagnostics'),
                open = $wrap.toggleClass('is-open').hasClass('is-open');
            $(this).attr('aria-expanded', open ? 'true' : 'false');
        });

        $('.sb-test-btn[data-group]').on('click', function () {
            var $btn = $(this),
                group = $btn.data('group'),
                $result = $('.sb-test-result[data-result-for="' + group + '"]'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Testing…');
            $result.removeClass('sb-result-ok sb-result-fail').text('').hide();

            $.ajax({
                url: testUrl,
                method: 'POST',
                dataType: 'json',
                data: { group: group, form_key: formKey }
            }).done(function (response) {
                renderResult($result, !!response.success, response.message || 'No response.');
            }).fail(function () {
                renderResult($result, false, 'Request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });

        $('#sb-webhook-test-btn').on('click', function () {
            var $btn = $(this),
                $result = $('#sb-webhook-result'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Testing…');
            $result.removeClass('sb-result-ok sb-result-fail').text('').hide();

            $.ajax({
                url: webhookTestUrl,
                method: 'POST',
                dataType: 'json',
                data: { form_key: formKey }
            }).done(function (response) {
                renderResult($result, !!response.success, response.message || 'No response.');
                if (response.detail) {
                    $('<pre class="sb-detail"/>').text(response.detail).appendTo($result);
                }
            }).fail(function () {
                renderResult($result, false, 'Request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });

        $('#sb-reindex-btn').on('click', function () {
            var $btn = $(this),
                $result = $('#sb-reindex-result'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Reindexing…');
            $result.removeClass('sb-result-ok sb-result-fail').empty().hide();

            $.ajax({
                url: reindexUrl,
                method: 'POST',
                dataType: 'json',
                data: { form_key: formKey }
            }).done(function (response) {
                renderSteps($result, response);
            }).fail(function () {
                renderResult($result, false, 'Reindex request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });

        $('#sb-cache-purge-btn').on('click', function () {
            var $btn = $(this),
                $result = $('#sb-cache-purge-result'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Purging…');
            $result.removeClass('sb-result-ok sb-result-fail').empty().hide();

            $.ajax({
                url: cachePurgeUrl,
                method: 'POST',
                dataType: 'json',
                data: { form_key: formKey }
            }).done(function (response) {
                renderSteps($result, response);
            }).fail(function () {
                renderResult($result, false, 'Cache purge request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });
    });
</script>
