            This disconnects SureBright from this store: it deletes the Magento integration,
            revokes the OAuth token &amp; consumer, and clears the stored SureBright credentials.
            The module files remain on disk — to fully remove them, run
            <code>bin/magento module:uninstall Surebright_Integration</code> from the server.
        </p>
        <button type="button" id="sb-uninstall-btn" class="sb-uninstall-btn action-secondary">
            Uninstall SureBright
        </button>
        <div id="sb-uninstall-result" class="sb-test-result"></div>
    </div>
</div>

<script>
    require(['jquery'], function ($) {
        'use strict';

        var testUrl = <?= /* @noEscape */ json_encode($block->getTestUrl()) ?>;
        var uninstallUrl = <?= /* @noEscape */ json_encode($block->getUninstallUrl()) ?>;
        var formKey = <?= /* @noEscape */ json_encode($block->getPageFormKey()) ?>;

        function renderResult($el, ok, message) {
            $el.removeClass('sb-result-ok sb-result-fail')
                .addClass(ok ? 'sb-result-ok' : 'sb-result-fail')
                .text(message)
                .show();
        }

        $('.sb-test-btn').on('click', function () {
            var $btn = $(this),
                group = $btn.data('group'),
                $result = $('.sb-test-result[data-result-for="' + group + '"]'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Testing…');
            $result.removeClass('sb-result-ok sb-result-fail').text('').hide();

            $.ajax({
                url: testUrl,
                method: 'POST',
                dataType: 'json',
                data: { group: group, form_key: formKey }
            }).done(function (response) {
                renderResult($result, !!response.success, response.message || 'No response.');
            }).fail(function () {
                renderResult($result, false, 'Request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });

        $('#sb-uninstall-btn').on('click', function () {
            if (!window.confirm('Disconnect SureBright from this store? This revokes the integration token and clears stored credentials.')) {
                return;
            }

            var $btn = $(this),
                $result = $('#sb-uninstall-result'),
                original = $btn.text();

            $btn.prop('disabled', true).text('Uninstalling…');
            $result.removeClass('sb-result-ok sb-result-fail').empty().hide();

            $.ajax({
                url: uninstallUrl,
                method: 'POST',
                dataType: 'json',
                data: { form_key: formKey }
            }).done(function (response) {
                var html = $('<div/>').text(response.message || 'Done.');
                if (response.steps && response.steps.length) {
                    var $ul = $('<ul class="sb-step-list"/>');
                    response.steps.forEach(function (step) {
                        $('<li/>')
                            .addClass(step.ok ? 'sb-step-ok' : 'sb-step-fail')
                            .text(step.step + ': ' + step.detail)
                            .appendTo($ul);
                    });
                    html.append($ul);
                }
                $result.removeClass('sb-result-ok sb-result-fail')
                    .addClass(response.success ? 'sb-result-ok' : 'sb-result-fail')
                    .html(html.html())
                    .show();
            }).fail(function () {
                renderResult($result, false, 'Uninstall request failed. Please try again.');
            }).always(function () {
                $btn.prop('disabled', false).text(original);
            });
        });
    });
</script>
